<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Red Flag or Green Flag?</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{--mint:#e3fde3;--lime:#a8ff90;--pale:#c4ffbd;--ink:#2626c6;--blue:#0000cc;--sky:#4477ff;--red:#ff4d5e;--white:#fff;
 box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{margin:0;min-height:100%}
body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;background:var(--blue);color:var(--white)}
.display{font-family:Anton,Impact,'Arial Narrow',sans-serif;text-transform:uppercase;line-height:.98;font-weight:400;margin:0}
.screen{position:relative;min-height:100vh;min-height:100dvh;overflow:hidden;display:flex;flex-direction:column;justify-content:center;padding:clamp(20px,5vw,64px)}
.wrap{position:relative;z-index:1;width:100%;max-width:860px;margin:0 auto}
.mint{background:var(--mint);color:var(--ink)}
.grad{background:linear-gradient(90deg,#0000cc 0%,#4477ff 100%)}
.deco{position:absolute;z-index:0;pointer-events:none;stroke:var(--pale);fill:none;stroke-width:16;stroke-linecap:round;stroke-linejoin:round}
.mint .deco{stroke:var(--blue)}
.display.title{font-size:clamp(44px,10vw,112px);color:var(--ink);font-weight:600;letter-spacing:0;line-height:1.08}
.intro{font-size:clamp(17px,2.4vw,22px);font-weight:500;max-width:560px;margin:28px 0 32px;color:var(--blue)}
.btn{font:700 clamp(17px,2.4vw,22px)/1 'DM Sans',sans-serif;border:0;border-radius:20px;padding:20px 32px;cursor:pointer;transition:transform .15s,box-shadow .15s;min-height:56px}
.btn:hover:not(:disabled){transform:translateY(-3px)}
.btn:active:not(:disabled){transform:translateY(0)}
.btn:focus-visible{outline:4px solid var(--white);outline-offset:3px;box-shadow:0 0 0 7px var(--ink)}
.start{background:var(--ink);color:var(--white)}
.mint .btn:focus-visible{outline-color:var(--ink);box-shadow:none}
.row{display:flex;gap:14px;align-items:flex-start}
.badge{flex:none;background:var(--lime);color:var(--ink);border-radius:22px;min-width:clamp(60px,9vw,120px);height:clamp(60px,9vw,120px);display:grid;place-items:center;font:400 clamp(34px,6vw,72px)/1 Anton,sans-serif;padding:0 10px}
.q{font-size:clamp(38px,8vw,92px);padding-top:.05em}
.meta{display:flex;justify-content:space-between;font-weight:700;font-size:15px;margin-bottom:10px}
.bar{height:12px;border-radius:99px;background:rgba(255,255,255,.25);overflow:hidden;margin-bottom:clamp(24px,5vw,48px)}
.bar i{display:block;height:100%;background:var(--lime);border-radius:99px;transition:width .5s cubic-bezier(.3,.8,.3,1)}
.scn{font-size:clamp(21px,3.4vw,34px);font-weight:500;line-height:1.35;margin:clamp(22px,4vw,40px) 0 clamp(24px,4vw,40px);max-width:680px;margin-left:clamp(0px,10vw,132px)}
.choices{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-left:clamp(0px,10vw,132px)}
.choice{background:var(--white);color:var(--ink);font-size:clamp(18px,2.6vw,26px);padding:26px 14px;display:flex;gap:10px;align-items:center;justify-content:center}
.choice .dot{width:22px;height:22px;border-radius:50%;flex:none}
.choice.g .dot,.dot.g{background:#1fbf4a}.choice.r .dot,.dot.r{background:var(--red)}
.choice:disabled{cursor:default;opacity:.5}
.choice.picked{opacity:1;outline:5px solid var(--lime)}
.fb{margin:22px 0 0 clamp(0px,10vw,132px);background:var(--mint);color:var(--ink);border-radius:24px;padding:clamp(20px,3vw,30px);animation:pop .35s cubic-bezier(.3,1.4,.5,1)}
.fb h2{font-size:clamp(30px,5vw,48px);margin-bottom:10px}
.fb p{margin:0 0 20px;font-size:clamp(16px,2.2vw,19px);line-height:1.5;color:#1a1a80}
.fb .btn{background:var(--ink);color:#fff}
@keyframes pop{from{opacity:0;transform:translateY(14px) scale(.97)}to{opacity:1;transform:none}}
.res{background:var(--mint);color:var(--ink);justify-content:flex-start}
.res .wrap{max-width:980px}
.big{font-size:clamp(70px,16vw,170px)}
.msg{font-size:clamp(20px,3vw,28px);font-weight:700;max-width:640px;margin:14px 0 8px;color:var(--blue)}
.note{font-size:14px;font-weight:500;opacity:.8;margin:0 0 28px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;margin-bottom:16px}
.card{background:var(--white);border-radius:24px;padding:24px}
.card h3{font:400 26px/1 Anton,sans-serif;text-transform:uppercase;margin:0 0 18px;color:var(--ink)}
.stat{margin-bottom:16px}.stat:last-child{margin-bottom:0}
.stat .lab{display:flex;justify-content:space-between;font-weight:700;font-size:15px;margin-bottom:6px}
.track{height:16px;border-radius:99px;background:#dcdcf5;overflow:hidden}
.track i{display:block;height:100%;border-radius:99px;width:0;transition:width .9s cubic-bezier(.3,.8,.3,1)}
.fillg{background:#1fbf4a}.fillr{background:var(--red)}.filli{background:var(--ink)}
.nums{display:flex;gap:10px;flex-wrap:wrap}
.num{flex:1;min-width:90px;background:var(--lime);border-radius:18px;padding:14px;text-align:center}
.num b{display:block;font:400 clamp(34px,5vw,48px)/1 Anton,sans-serif}.num span{font-size:13px;font-weight:700}
.num.bad{background:#ffd5d9}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin:24px 0}
.btn.alt{background:var(--white);color:var(--ink)}.btn.main{background:var(--ink);color:#fff}
.rev{display:grid;gap:12px;margin-bottom:40px}
.item{background:var(--white);border-radius:20px;padding:20px}
.item .tag{display:inline-block;font-weight:700;font-size:14px;border-radius:99px;padding:5px 12px;margin-bottom:10px}
.tag.ok{background:var(--lime)}.tag.no{background:#ffd5d9}
.item p{margin:0 0 10px;line-height:1.5}.item .ans{font-weight:700;font-size:14px}
.empty{text-align:center}
@media (max-width:560px){.choices{grid-template-columns:1fr}.scn,.choices,.fb{margin-left:0}.row{gap:10px}}
.display,.badge,.num b,.card h3{font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;line-height:1.05}
.btn{font-family:'Plus Jakarta Sans',system-ui,sans-serif}
.badge{border-radius:20px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="root"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.3.1/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.3.1/umd/react-dom.production.min.js"></script>
<script>
/* ============ EDIT YOUR CONTENT HERE ============
   id: unique number | answer: 'green' or 'red' | category: any label | text + explanation: any copy */
const SCENARIOS = [
 {id:1,category:'Mistakes',answer:'green',text:'“I made a mistake, told my manager, and asked for help fixing it.”',explanation:'Admitting a mistake early and asking for help is exactly what psychological safety makes possible. Problems get fixed faster when people don’t hide them.'},
 {id:2,category:'Accountability',answer:'red',text:'“I made the same mistake again, but hey… mistakes are allowed, right?”',explanation:'Psychological safety isn’t a free pass. Honest mistakes are how we learn, but repeating an avoidable one without reflecting or changing anything is a lack of accountability.'},
 {id:3,category:'Feedback',answer:'green',text:'“Your teammate points out a mistake in your work. You listen, ask questions, and use their feedback to improve next time.”',explanation:'Receiving feedback with curiosity builds trust. It tells teammates that speaking up is welcome and worth the effort.'},
 {id:4,category:'Accountability',answer:'red',text:'“You make a mistake, but instead of owning it, you blame your teammate and refuse to acknowledge your part in what happened.”',explanation:'Blaming others makes everyone more careful about what they share. Owning your part, even a small one, keeps the team learning together.'},
 {id:5,category:'Speaking up',answer:'red',text:'In a meeting, a colleague asks what an acronym means. Someone laughs and says, “Seriously? You still don’t know that?”',explanation:'Mocking a question teaches people to stay quiet. Questions are how teams find gaps, and a safe team answers them without humiliation.'}
];
/* =============================================== */

const h = React.createElement, {useState, useEffect, useRef} = React;
const LABEL = {green:'Green Flag', red:'Red Flag'};
const DECOS = [
 ['M20 330C60 200 150 80 270 70c60-4 70 60 40 150-30 100-50 200-20 260 25 50 90 40 150-5'],
 ['M0 60C90 70 170 120 220 190','M10 480c120-40 200-110 260-200'],
 ['M0 230C100 200 160 140 200 70','M400 140c80 60 190 90 320 40'],
 ['M20 120c120-10 210-60 250-150','M300 420l50-90 40 90 50-80']
];
function Deco({n}){
  const d = DECOS[n % DECOS.length];
  const pos = [{right:'-30px',top:'36%'},{left:'-30px',bottom:'30px'},{left:'-30px',top:'20px'},{right:'0',bottom:'20px'}][n % 4];
  return h('svg',{className:'deco',viewBox:'0 0 500 500',width:360,height:360,'aria-hidden':true,style:pos},d.map((p,i)=>h('path',{key:i,d:p})));
}

function Welcome({onStart}){
  const ok = SCENARIOS.length > 0;
  return h('main',{className:'screen mint'},
    h('div',{className:'wrap'},
      h('h1',{className:'display title'},'Red',h('br'),'flag',h('br'),'or',h('br'),'green',h('br'),'flag'),
      ok ? h('p',{className:'intro'},'Not every workplace behavior is what it seems! 🚩 Read each scenario, trust your judgment, and decide: green flag or red flag? Just 5 quick scenarios, no names, nothing saved.')
         : h('p',{className:'intro'},'No scenarios found. Add some to the SCENARIOS list at the top of the script.'),
      ok && h('button',{className:'btn start',onClick:onStart},'Start playing')));
}

function Play({idx,answers,onAnswer,onNext}){
  const s = SCENARIOS[idx], a = answers[idx], total = SCENARIOS.length;
  const nextRef = useRef(null);
  useEffect(()=>{ if(a && nextRef.current) nextRef.current.focus(); },[a]);
  const pct = ((idx + (a ? 1 : 0)) / total) * 100;
  const last = idx === total - 1;
  return h('main',{className:'screen grad'},
    h('div',{className:'wrap',key:idx},
      h('div',{className:'meta'},h('span',null,'Scenario '+(idx+1)+' of '+total),h('span',null,answers.filter(x=>x&&x.isCorrect).length+' correct')),
      h('div',{className:'bar',role:'progressbar','aria-valuemin':0,'aria-valuemax':total,'aria-valuenow':idx+(a?1:0)},h('i',{style:{width:pct+'%'}})),
      h('div',{className:'row'},h('div',{className:'badge'},idx+1),h('h2',{className:'display q'},'Is it green',h('br'),'or red?')),
      h('p',{className:'scn'},s.text),
      h('div',{className:'choices'},['green','red'].map(k=>
        h('button',{key:k,className:'btn choice '+(k==='green'?'g':'r')+(a&&a.selected===k?' picked':''),disabled:!!a,'aria-pressed':a?a.selected===k:undefined,onClick:()=>onAnswer(k)},
          h('span',{className:'dot g'.replace('g',k==='green'?'g':'r')}),LABEL[k]))),
      a && h('div',{className:'fb',role:'status'},
        h('h2',{className:'display'},a.isCorrect?'Nice catch! ✅':'Good to know! 💡'),
        h('p',null,h('b',null,'This one is a '+LABEL[s.answer]+'. '),s.explanation),
        h('button',{ref:nextRef,className:'btn',onClick:onNext},last?'See my results':'Next scenario'))));
}

function Stat({label,value,max,cls}){
  const [w,setW] = useState(0);
  useEffect(()=>{ const t=setTimeout(()=>setW(max?value/max*100:0),60); return ()=>clearTimeout(t); },[value,max]);
  return h('div',{className:'stat'},h('div',{className:'lab'},h('span',null,label),h('span',null,value+' / '+max)),
    h('div',{className:'track'},h('i',{className:cls,style:{width:w+'%'}})));
}

function Results({answers,onReplay}){
  const [showReview,setShowReview] = useState(false);
  const done = answers.filter(Boolean);
  const total = SCENARIOS.length;
  if(!total || done.length < total) return h('main',{className:'screen mint empty'},h('p',null,'Finish all scenarios to see your results.'),h('button',{className:'btn start',onClick:onReplay},'Back to start'));
  const correct = done.filter(a=>a.isCorrect).length;
  const acc = Math.round(correct/total*100);
  const incorrect = total - correct;
  const of = k => done.filter(a=>a.answer===k);
  const gT = of('green').length, rT = of('red').length;
  const gC = of('green').filter(a=>a.isCorrect).length, rC = of('red').filter(a=>a.isCorrect).length;
  const cats = {};
  done.forEach(a=>{ const c=a.category||'General'; cats[c]=cats[c]||{t:0,c:0}; cats[c].t++; if(a.isCorrect) cats[c].c++; });
  const msg = acc>=90 ? 'Flag Expert! 🚩 You have a great eye for psychologically safe behaviors.'
            : acc>=70 ? 'You’re getting there! 💚 A few scenarios might surprise you.'
            : 'Every situation is a chance to learn. Keep exploring what makes a workplace feel safe.';
  return h('main',{className:'screen res'},
    h('div',{className:'wrap'},
      h('h1',{className:'display big'},acc+'%'),
      h('p',{className:'msg'},msg),
      h('p',{className:'note'},'These results show only your answers from this game. They aren’t saved or shared.'),
      h('div',{className:'grid'},
        h('section',{className:'card','aria-label':'Overall score'},h('h3',null,'Overall score'),
          h('div',{className:'nums'},
            h('div',{className:'num'},h('b',null,correct),h('span',null,'Correct')),
            h('div',{className:'num bad'},h('b',null,incorrect),h('span',null,'Incorrect')),
            h('div',{className:'num'},h('b',null,total),h('span',null,'Scenarios'))),
          h('div',{style:{marginTop:18}},h(Stat,{label:'Accuracy',value:correct,max:total,cls:'filli'}))),
        h('section',{className:'card','aria-label':'Flag decisions'},h('h3',null,'Your flag decisions'),
          h(Stat,{label:'🟢 Green flags spotted',value:gC,max:gT,cls:'fillg'}),
          h(Stat,{label:'🔴 Red flags spotted',value:rC,max:rT,cls:'fillr'}),
          h('p',{style:{margin:'16px 0 0',fontSize:14,fontWeight:500}},'Missed: '+(gT-gC)+' green, '+(rT-rC)+' red'))),
      h('section',{className:'card','aria-label':'By category',style:{marginBottom:16}},h('h3',null,'By category'),
        Object.keys(cats).map(c=>h(Stat,{key:c,label:c,value:cats[c].c,max:cats[c].t,cls:'filli'}))),
      h('div',{className:'actions'},
        h('button',{className:'btn main',onClick:onReplay},'Play again'),
        h('button',{className:'btn alt','aria-expanded':showReview,onClick:()=>setShowReview(v=>!v)},showReview?'Hide answers':'Review answers')),
      showReview && h('div',{className:'rev'},done.map((a,i)=>
        h('article',{className:'item',key:a.id},
          h('span',{className:'tag '+(a.isCorrect?'ok':'no')},(i+1)+'. '+(a.isCorrect?'Correct':'Not quite')),
          h('p',null,a.text),
          h('p',{className:'ans'},'You said: '+LABEL[a.selected]+'  |  Answer: '+LABEL[a.answer]),
          h('p',null,a.explanation))))));
}

function App(){
  const [screen,setScreen] = useState('welcome');
  const [idx,setIdx] = useState(0);
  const [answers,setAnswers] = useState([]);
  const start = () => { setAnswers([]); setIdx(0); setScreen('play'); window.scrollTo(0,0); };
  const answer = k => {
    if(answers[idx]) return; /* one answer per scenario */
    const s = SCENARIOS[idx];
    const rec = {id:s.id,text:s.text,answer:s.answer,selected:k,isCorrect:k===s.answer,explanation:s.explanation,category:s.category};
    setAnswers(p => { if(p[idx]) return p; const n=p.slice(); n[idx]=rec; return n; });
  };
  const next = () => { window.scrollTo(0,0); if(idx+1 < SCENARIOS.length) setIdx(idx+1); else setScreen('results'); };
  if(screen==='play' && SCENARIOS.length) return h(Play,{idx,answers,onAnswer:answer,onNext:next});
  if(screen==='results') return h(Results,{answers,onReplay:()=>{setScreen('welcome');setAnswers([]);setIdx(0);window.scrollTo(0,0);}});
  return h(Welcome,{onStart:start});
}
ReactDOM.createRoot(document.getElementById('root')).render(h(App));
</script>
</body>
</html>
